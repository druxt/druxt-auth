{
  "name": "druxt-auth",
  "version": "0.4.0",
  "keywords": [
    "auth",
    "authentication",
    "drupal",
    "druxt",
    "module",
    "nuxt",
    "oauth"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.ssr.js",
      "import": "./dist/index.esm.js"
    }
  },
  "main": "dist/index.ssr.js",
  "module": "dist/index.esm.js",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "siroc build",
    "build:watch": "siroc build --watch",
    "changeset": "changeset",
    "example": "cd example/nuxt && yarn && yarn dev",
    "lint": "yarn lint:js && yarn lint:md && yarn lint:cspell && yarn lint:private",
    "lint:commit": "commitlint",
    "lint:cspell": "cspell lint --no-progress --no-must-find-files --gitignore --dot \"**/*.{js,vue,mjs,json,md,yml,yaml}\"",
    "lint:js": "eslint --ext .js,.mjs,.vue src test scripts",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:private": "node scripts/lint-private-refs.mjs",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nuxtjs/auth-next": "^5.0.0-1667386184.dfbbb54"
  },
  "devDependencies": {
    "@babel/core": "7.22.9",
    "@babel/preset-env": "7.22.9",
    "@changesets/cli": "^2.26.2",
    "@commitlint/cli": "16.3.0",
    "@commitlint/config-conventional": "16.2.4",
    "@vue/test-utils": "1.3.6",
    "babel-core": "7.0.0-bridge.0",
    "cspell": "7.3.9",
    "druxt": "0.23.0",
    "esbuild-jest": "0.5.0",
    "eslint": "8.45.0",
    "eslint-plugin-nuxt": "3.2.0",
    "jest": "27.5.1",
    "jest-junit": "^14.0.1",
    "markdownlint-cli2": "0.10.0",
    "siroc": "0.16.0",
    "vue-jest": "3.0.7",
    "vue-template-compiler": "^2.7.14"
  },
  "peerDependencies": {
    "axios": "^0.27.2",
    "body-parser": "^1.20.2"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public"
  }
}

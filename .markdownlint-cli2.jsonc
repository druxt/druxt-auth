{
  "config": {
    "default": true,
    // Prose wraps at whatever the author chose; line length is not a defect.
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD041": false
  },
  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    "coverage/**",
    "dist/**",
    "example/**/node_modules/**",
    // Composer installs these; they are upstream's prose, not ours.
    "example/drupal/vendor/**",
    "example/drupal/web/core/**",
    "example/drupal/web/**/contrib/**",
    "example/drupal/web/libraries/**",
    // Written by changesets, not by hand.
    ".changeset/**",
    "**/CHANGELOG.md"
  ]
}

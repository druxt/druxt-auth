{
  "files": [
    "**/*.{js,vue,mjs,json,md,yml,yaml}"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell-project-words.txt"
    }
  ],
  "dictionaries": [
    "project-words",
    "bash",
    "misc",
    "node",
    "softwareTerms"
  ],
  "ignorePaths": [
    ".git/",
    "node_modules/",
    "**/node_modules/",
    "coverage/",
    "dist/",
    "**/CHANGELOG.md",
    "example/drupal/",
    ".vscode/",
    ".gitpod/",
    ".gitpod.yml",
    "*.lock",
    "yarn.lock",
    "package-lock.json",
    "*.svg",
    "*.png",
    "*.ico",
    "*.min.*"
  ],
  "useGitignore": true,
  "language": "en,en-GB",
  "ignoreRegExpList": [
    "\\\\e\\[0K\\w*"
  ]
}
